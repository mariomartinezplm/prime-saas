# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prime-fh?retryWrites=true&w=majority

# JWT Secret Key (generar una clave segura aleatoria)
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiar_en_produccion

# Vida del access token (JWT corto). El refresh token —opaco, en cookie
# HttpOnly, ver backend/utils/refreshTokens.js— es el que ahora sostiene la
# sesión larga de 30 días (Paso 08 de BLUEPRINT.md).
JWT_EXPIRE=1h

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Email Configuration (opcional - para notificaciones futuras)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_FROM=Prime F&H <noreply@primefh.cl>

# Airtable Configuration (para migración de pacientes)
AIRTABLE_API_KEY=pat_tu_personal_access_token_aqui
AIRTABLE_BASE_ID=app_tu_base_id_aqui
AIRTABLE_TABLE_NAME=Pacientes
# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prime-fh?retryWrites=true&w=majority

# JWT Secret Key (generar una clave segura aleatoria)
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiar_en_produccion

# Vida del access token (JWT corto). El refresh token —opaco, en cookie
# HttpOnly, ver backend/utils/refreshTokens.js— es el que ahora sostiene la
# sesión larga de 30 días (Paso 08 de BLUEPRINT.md).
JWT_EXPIRE=1h

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL (para CORS). El puerto real de desarrollo es 8080, no el 5173
# por defecto de Vite — ver vite.config.ts.
FRONTEND_URL=http://localhost:8080

# Resend (Paso 11 de BLUEPRINT.md): API key de la cuenta de Resend, con el
# dominio primefh.cl ya verificado (SPF/DKIM). Sin esta variable, el sistema
# arranca igual y solo registra un aviso al intentar enviar un correo — nunca
# se cae por esto.
RESEND_API_KEY=re_tu_api_key_de_resend_aqui

# Airtable Configuration (para migración de pacientes)
AIRTABLE_API_KEY=pat_tu_personal_access_token_aqui
AIRTABLE_BASE_ID=app_tu_base_id_aqui
AIRTABLE_TABLE_NAME=Pacientes

# Clave de cifrado (Paso 28 de BLUEPRINT.md): protege en reposo los tokens de
# Google Calendar guardados en User.googleTokens (AES-256-GCM). Generar UNA
# vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y guardarla igual que JWT_SECRET — si se pierde o cambia, todos los usuarios
# quedan desconectados de Google Calendar y deben reconectar.
ENCRYPTION_KEY=

# Google Calendar OAuth (Paso 28 de BLUEPRINT.md): credenciales de la app
# registrada en Google Cloud Console (tipo "Web application"), con
# ${FRONTEND_URL}/auth/google/callback como Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
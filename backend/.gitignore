# Dependencias
node_modules/
# package-lock.json SÍ va al repositorio: fija las versiones exactas de cada
# librería. Sin él, Railway instala en cada despliegue "lo más nuevo compatible",
# que puede no ser lo que se probó — y basta con que una actualización cambie algo
# para que el servidor deje de funcionar sin haber tocado una línea de código.

# Variables de entorno
.env
.env.local
.env.development
.env.production

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids
*.pid
*.seed
*.pid.lock

# Directorio de cobertura de tests
coverage/
.nyc_output/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/

# Datos con información real de pacientes (PII) — nunca al repo
scripts/data/
